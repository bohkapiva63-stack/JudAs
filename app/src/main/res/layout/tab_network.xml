<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Онлайн видео и Торренты 🌐"
        android:textColor="@color/judas_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/card_dark"
        android:hint="Введите URL (http, m3u8, TorrServer)"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_light"
        android:padding="14dp" />

    <Button
        android:id="@+id/playUrlBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/judas_green"
        android:text="Воспроизвести поток / видео"
        android:textColor="#000000" />

    <Button
        android:id="@+id/torrServerBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/judas_green_dark"
        android:text="Вставить префикс TorrServer (127.0.0.1:8090)"
        android:textColor="#FFFFFF" />

</LinearLayout>
