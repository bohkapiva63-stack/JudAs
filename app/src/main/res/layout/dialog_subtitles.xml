<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 Онлайн поиск субтитров"
        android:textColor="@color/judas_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/subSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/bg_dark"
        android:hint="Введите название фильма / аниме"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_light"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnSearchSubs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/judas_green"
        android:text="Искать субтитры"
        android:textColor="#000000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subResultsList"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
