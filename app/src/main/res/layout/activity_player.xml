<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="always" />

    <!-- Top Action Bar inside Player -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end">

        <Button
            android:id="@+id/btnResize"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/card_dark"
            android:text="Экран: Заполнение"
            android:textColor="@color/judas_green"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSubtitles"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/card_dark"
            android:text="🔍 Субтитры Онлайн"
            android:textColor="@color/judas_green_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Floating Skip Segment Button (Skip Intro / Opening) -->
    <Button
        android:id="@+id/btnSkipSegment"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="90dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone"
        android:backgroundTint="@color/judas_green"
        android:text="⏩ Пропустить опенинг"
        android:textColor="#000000"
        android:textStyle="bold" />

    <!-- Gesture Indicator Overlay (Volume / Brightness) -->
    <TextView
        android:id="@+id/gestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@color/card_dark"
        android:padding="16dp"
        android:textColor="@color/judas_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
