<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_buffering="always" />

    <!-- Top Overlay Bar (Auto-hides with player controls) -->
    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#A0000000"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnResize"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/card_dark"
            android:text="Экран: Заполнение"
            android:textColor="@color/judas_green"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnQuality"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/card_dark"
            android:text="🎥 Качество"
            android:textColor="@color/judas_green_accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSubtitles"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/card_dark"
            android:text="🔍 Субтитры"
            android:textColor="@color/text_light"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSkipOp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/judas_green"
            android:text="⏩ +85с Опенинг"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gesture Indicator Overlay (Volume / Brightness) -->
    <TextView
        android:id="@+id/gestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#D0132B1D"
        android:padding="20dp"
        android:textColor="@color/judas_green"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
