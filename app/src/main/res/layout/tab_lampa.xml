<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Интеграция с Lampa 🟢"
        android:textColor="@color/judas_green"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Статус сервера REST API: Активен (Порт 8080)"
        android:textColor="@color/text_light"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Синхронизация таймкодов: Включена"
        android:textColor="@color/judas_green_accent"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ссылка на плагин для Lampa:"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/card_dark"
        android:padding="12dp"
        android:text="http://127.0.0.1:8080/lampa_plugin.js"
        android:textColor="@color/judas_green"
        android:textSize="14sp"
        android:textIsSelectable="true" />

</LinearLayout>
